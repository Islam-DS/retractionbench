# Copy this file to .env and fill in real values. Never commit .env.
# Non-secret configuration (paths, model lists, retrieval settings) lives in
# config/default.yaml, not here -- this file is for credentials only.

# --- PubMed / NCBI E-utilities ---
# Required by NCBI's usage policy: identifies you to their API. No account needed.
NCBI_EMAIL=you@example.com
# Optional but recommended: raises the E-utilities rate limit from 3 to 10 req/sec.
# Get one at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# --- Model providers, called via litellm ---
# Only fill in the providers you actually plan to evaluate.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Hugging Face Hub, only needed for gated sentence-transformers models ---
HF_TOKEN=
